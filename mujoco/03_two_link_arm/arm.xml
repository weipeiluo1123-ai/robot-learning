<mujoco model="two_link_arm">
  <option timestep="0.01" gravity="0 0 -9.81" integrator="implicitfast"/>

  <worldbody>
    <geom
      name="floor"
      type="plane"
      size="2 2 0.1"
    />

    <body name="link1" pos="0 0 1.5">
      <joint
        name="joint1"
        type="hinge"
        axis="0 1 0"
        damping="1"
      />

      <geom
        name="link1_geom"
        type="capsule"
        fromto="0 0 0 0 0 -0.6"
        size="0.05"
        mass="1"
        rgba="0.2 0.6 1 1"
      />

      <body name="link2" pos="0 0 -0.6">
        <joint
          name="joint2"
          type="hinge"
          axis="0 1 0"
          damping="1"
        />

        <geom
          name="link2_geom"
          type="capsule"
          fromto="0 0 0 0 0 -0.6"
          size="0.05"
          mass="1"
          rgba="1 0.5 0.2 1"
        />

        <site
          name="end_effector"
          pos="0 0 -0.6"
          size="0.06"
          rgba="0.2 1 0.3 1"
        />
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="joint1_position" joint="joint1" kp="160" dampratio="1"/>
    <position name="joint2_position" joint="joint2" kp="160" dampratio="1"/>
  </actuator>
</mujoco>